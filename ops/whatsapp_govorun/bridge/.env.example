WA_TRIGGER=@govorun
WA_DM_ALWAYS_RESPOND=true
WA_GROUP_TRIGGER_REQUIRED=true
WA_ALLOWED_GROUPS=
WA_ALLOWED_DMS=
WA_STATE_DIR=/home/wa-govorun/whatsapp-govorun/state
WA_AUTH_DIR=/home/wa-govorun/whatsapp-govorun/state/auth
WA_LOGS_DIR=/home/wa-govorun/whatsapp-govorun/state/logs
WA_RESPONSE_MAX_CHARS=3500
# Optional: set digits-only phone to use pairing-code fallback instead of QR
WA_PAIRING_PHONE=
# Optional custom 8-char pairing code (leave blank to auto-generate)
WA_PAIRING_CODE=
# === Agent runtime selector ===
# Default "codex" preserves the existing behavior. Set to "pi" to route
# prompts through the pi coding agent instead. Both runtimes are
# implemented in src/agent.mjs; flip this var + restart to switch.
WA_AGENT_RUNTIME=codex       # codex | pi

# === Codex runtime (only used when WA_AGENT_RUNTIME=codex) ===
CODEX_WORKDIR=/home/architect/matrix
CODEX_MODEL=gpt-5-codex-mini
CODEX_REASONING_EFFORT=medium
CODEX_FULL_ACCESS=true
CODEX_BIN=/usr/local/bin/codex
CODEX_TIMEOUT_MS=240000

# === Pi runtime (only used when WA_AGENT_RUNTIME=pi) ===
# Pi reads ~/.pi/agent/auth.json for provider API keys. The runtime user
# must be in the `pi-users` group to read the shared /etc/server3-pi/auth.json.
# PI_PROVIDER must match a key in that auth.json.
PI_PROVIDER=minimax          # deepseek | minimax | venice | ollama | ...
PI_MODEL=MiniMax-M3
PI_THINKING=high             # off | minimal | low | medium | high | xhigh
PI_BIN=pi
PI_TIMEOUT_MS=3600000        # 1 hour
PI_WORKDIR=/home/govorun/whatsapp-govorun/app

LOG_LEVEL=info
